# What the sdist ships beyond setuptools' defaults. The wheel carries only
# the deadeye package; the sdist is a complete source tree, so everything
# README.md tells a contributor to run from a checkout (scripts/bootstrap,
# uv sync --locked, make check test) works from an unpacked tarball.
include CHANGELOG.md CONTRIBUTING.md SECURITY.md
include Makefile uv.lock .python-version
include config.toml
include src/deadeye/config.local.toml.example
graft tests
graft docs
graft scripts
# tests/test_release_contract.py reads the CI matrix and the release job out of
# .github to pin the wheel classifiers and the release checksums, so the
# shipped suite fails from a tarball that leaves those out. Graft both halves:
# the workflows, and the composite action ci.yml calls.
graft .github
global-exclude __pycache__ *.py[cod]
